var IDS=[];
var ROSTER=[],RL=null;
function agg(){
  var L={};
  PARSED.forEach(function(d){
    var k=nm(d.name),e=L[k]||(L[k]={name:d.name,n:0,best:0,date:"",prog:"",pd:""});
    e.n++;e.best=Math.max(e.best,Math.round(100*score(d)/d.items.length));
    if(d.date>e.date)e.date=d.date;
    if(d.mode[0]==="P"&&d.date>=e.pd){e.pd=d.date;e.prog=d.prog||e.prog}
  });
  return L;
}
function nv(e){return(e.prog.match(/1/g)||[]).length}
function renderRoster(){
  var o=$("#ids");o.textContent="";
  if(!IDS.length)IDS=ROSTER.map(n=>({n:n,id:mkid(n)}));$("#mkCsv").hidden=!IDS.length;
  var query=($("#rosterSearch")&&$("#rosterSearch").value||"").trim().toLowerCase(), visible=IDS.filter(x=>!query||x.n.toLowerCase().includes(query)||x.id.toLowerCase().includes(query));
  var dl=$("#rosterDl");if(dl){dl.textContent="";ROSTER.forEach(n=>dl.append(h("option",{value:n})));}
  if(!IDS.length){o.append(h("p",{class:"muted",text:"Aucun apprenant enregistré. Collez la liste des noms ci-dessus."}));return}
  var L=agg(),bd=h("tbody");
  visible.forEach(function(x){
    var e=L[nm(x.n)],del=null;
    if(e){del=h("span",{class:"muted",text:"Historique conservé"})}
    bd.append(h("tr",{},h("td",{text:x.n}),h("td",{class:"code",style:"font-weight:700",text:x.id}),h("td",{text:e?nv(e)+"/6 étapes · "+e.n+" tentative(s) · "+e.date:"Aucun résultat reçu"}),h("td",{},del||h("span",{class:"muted",text:"—"}))));
  });
  o.append(h("p",{class:"muted",text:visible.length+" apprenant(s) affiché(s) sur "+IDS.length+" · "+IDS.filter(x=>L[nm(x.n)]).length+" ont déjà envoyé un résultat."}),
    h("div",{class:"wrap"},h("table",{},h("thead",{},h("tr",{},h("th",{text:"Nom"}),h("th",{text:"Identifiant"}),h("th",{text:"Statut"}),h("th",{text:"Action"}))),bd)));
}
$("#rosterSearch").oninput=renderRoster;
$("#mk").onclick=async function(){
  var m=$("#idsMsg");m.textContent="Enregistrement en cours…";
  try{var r=await API("learner_create",{first_name:$("#learnerFirst").value,last_name:$("#learnerLast").value,formation_id:$("#learnerFormation").value});if(!r.ok){m.textContent=r.msg||"Impossible d'enregistrer l'apprenant.";return}$("#learnerFirst").value="";$("#learnerLast").value="";m.innerHTML="<div style='background:var(--okbg);border:1px solid var(--ok);border-radius:8px;padding:12px;margin:8px 0'><b style='color:var(--ok)'>✓ Apprenant cré.</b><br><b>Identifiant :</b> <span style='font-family:monospace'>"+r.identifier+"</span><br><b>Mot de passe temporaire :</b> <span style='color:var(--navy);font-weight:bold;font-family:monospace;background:#fff;padding:2px 6px;border-radius:4px;border:1px solid var(--line)'>"+r.temporary_password+"</span><br><b>Formation :</b> "+r.formation_id+"<br><span class='muted' style='font-size:.85rem'>Communiquez ces identifiants à l'apprenant. Le mot de passe ne s'affichera plus après cette page.</span></div>";pushCreated("learner",{name:r.name,identifier:r.identifier,password:r.temporary_password,formation:r.formation_id});if(typeof loadLearners=== "function")loadLearners();renderRoster()}catch(e){m.textContent="Impossible d'enregistrer l'apprenant."}
};
document.querySelectorAll("#subnav button").forEach(function(b){b.onclick=function(){
  document.querySelectorAll(".sp").forEach(function(panel){panel.hidden=panel.id!==b.dataset.p});
  document.querySelectorAll("#subnav button").forEach(function(button){if(button===b){button.className="";button.setAttribute("aria-current","page")}else{button.className="alt";button.removeAttribute("aria-current")}});
  if(b.dataset.p==="pD")refreshDashboard();
  if(b.dataset.p==="pR"){refreshDynamicResults();if(window.loadResultsPage)window.loadResultsPage();}
  if(b.dataset.p==="pN"&&window.loadGradesPage)window.loadGradesPage();
}});
