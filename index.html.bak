async function pwh(u,p){var t=nm(u)+"|"+p+"|ndartech-adm";try{var b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(t));return Array.from(new Uint8Array(b)).map(x=>("0"+x.toString(16)).slice(-2)).join("")}catch(e){return "w"+hs(t)}}
