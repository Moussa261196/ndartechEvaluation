function enterPrivate(){document.getElementById("publicSite").hidden=true;document.getElementById("authModal").hidden=true;document.body.classList.remove("public-open");document.getElementById("privateMain").hidden=false;window.scrollTo(0,0)}
function enforceTemporaryPassword(){return new Promise(function(resolve){var overlay=document.createElement("div");overlay.style.cssText="position:fixed;inset:0;z-index:200;background:rgba(10,18,40,.72);display:grid;place-items:center;padding:20px";var panel=document.createElement("div");panel.style.cssText="width:min(420px,100%);background:#fff;border-radius:20px;padding:28px;box-shadow:0 10px 30px rgba(0,0,0,.2)";panel.innerHTML="<h2 style=\"color:#1f2a5e;margin-top:0\">Première connexion</h2><p>Choisissez votre nouveau mot de passe (12 caractères minimum).</p><label>Nouveau mot de passe</label><input id=\"tpNew\" type=\"password\" style=\"width:100%;padding:10px;margin:6px 0 12px;border:1.5px solid #d5dcea;border-radius:10px\"><label>Confirmation</label><input id=\"tpConfirm\" type=\"password\" style=\"width:100%;padding:10px;margin:6px 0 12px;border:1.5px solid #d5dcea;border-radius:10px\"><p id=\"tpErr\" style=\"color:#b3261e;font-weight:600;min-height:1.2em\"></p><button id=\"tpSave\" type=\"button\" style=\"width:100%\">Enregistrer</button>";overlay.append(panel);document.body.append(overlay);var save=panel.querySelector("#tpSave");save.onclick=async function(){var first=panel.querySelector("#tpNew").value;var second=panel.querySelector("#tpConfirm").value;var err=panel.querySelector("#tpErr");err.textContent="";if(first.length<12){err.textContent="Le mot de passe doit contenir au moins 12 caractères.";return}if(first!==second){err.textContent="Les deux mots de passe ne sont pas identiques.";return}save.disabled=true;try{var r=await API("change_temporary_password",{new:first,confirm:second});if(!r.ok){err.textContent=r.msg||"Modification impossible.";save.disabled=false;return}alert("Mot de passe modifié avec succès.");overlay.remove();resolve(true)}catch(x){err.textContent="Modification impossible pour le moment.";save.disabled=false}}})}
async function refreshLearnerHistory(){await loadLearnerData()}
document.querySelectorAll("[data-learner-view]").forEach(function(button){button.addEventListener("click",function(){showLearnerView(button.getAttribute("data-learner-view"))})});
document.querySelectorAll("[data-learner-goto]").forEach(function(button){button.addEventListener("click",function(){showLearnerView(button.getAttribute("data-learner-goto"))})});
document.getElementById("learnerLogout").addEventListener("click",logout);
document.getElementById("historyMode").addEventListener("change",renderLearnerHistory);
document.getElementById("historyRefresh").addEventListener("click",loadLearnerData);
document.getElementById("learnerPasswordSave").addEventListener("click",async function(){
  var button=this,message=$("#learnerPasswordMessage"),current=$("#learnerCurrentPassword").value,newPassword=$("#learnerNewPassword").value,confirmation=$("#learnerConfirmPassword").value;
  message.textContent="";if(!current||newPassword.length<12){message.textContent="Entrez votre mot de passe actuel et un nouveau mot de passe de 12 caractères minimum.";return}
  if(newPassword!==confirmation){message.textContent="Les deux nouveaux mots de passe ne sont pas identiques.";return}
  button.disabled=true;
  try{var response=await API("learner_change_password",{current:current,new:newPassword,confirm:confirmation});if(!response.ok){message.textContent=response.msg||"Le mot de passe n’a pas pu être modifié.";return}$("#learnerCurrentPassword").value="";$("#learnerNewPassword").value="";$("#learnerConfirmPassword").value="";message.textContent="Votre mot de passe a été modifié."}
  catch(e){message.textContent="Impossible de modifier le mot de passe. Vérifiez votre connexion, puis réessayez."}
  finally{button.disabled=false}
});
function routeSession(r){
  if(!r||r.role=== "none")return;
  enterPrivate();
  if(r.must_change_password){enforceTemporaryPassword().then(function(ok){if(ok){claude.refresh().then(function(v){routeSession(v)})}});return}
  if(r.role=== "learner"){
    PN=r.name||PN;
    document.body.classList.remove("staff-mode");
    document.body.classList.add("learner-mode");
    document.getElementById("privateTitle").textContent="Interface de tests apprenant";
    document.getElementById("privateSubtitle").textContent="Bienvenue, "+PN+". Votre formation et ses modules sont appliqués automatiquement.";
    document.getElementById("privateTabs").hidden=true;
    document.getElementById("setup").hidden=true;
    document.getElementById("setup").classList.remove("learner-direct-test");
    document.getElementById("learnerApp").hidden=false;
    document.getElementById("play").hidden=true;document.getElementById("result").hidden=true;document.getElementById("map").hidden=true;
    document.getElementById("quizView").hidden=false;
    document.getElementById("trainerView").hidden=true;
    document.getElementById("who").textContent="Connecté : "+PN;
    $("#profileName").textContent="Nom : "+PN;
    LEARNER_IDENTIFIER=r.identifier||LEARNER_IDENTIFIER;
    $("#profileIdentifier").textContent="Identifiant : "+(LEARNER_IDENTIFIER||"contactez votre formateur pour le retrouver.");
    if(r.formation_id){loadFormations(r.formation_id);showLearnerView("home")}else{$("#formationPicker").hidden=true;$("#learnerFormationName").textContent="Formation non attribuée";$("#resumeCard").textContent="Aucune formation ne vous a été attribuée. Contactez votre formateur."}
    return;
  }
  if(r.role=== "admin" || r.role=== "formateur"){
    document.body.classList.remove("learner-mode");
    document.body.classList.add("staff-mode");
    STAFF_ROLE=r.staff_role||(r.role=== "formateur"?"formateur":"admin");
    document.getElementById("privateTitle").textContent=STAFF_ROLE=== "formateur"?"Tableau de bord formateur":"Tableau de bord administrateur";
    document.getElementById("privateSubtitle").textContent=STAFF_ROLE=== "formateur"?"Gestion de vos apprenants et des formations attribuées.":"Gestion complète de la plateforme.";
    document.getElementById("privateTabs").hidden=true;
    document.getElementById("quizView").hidden=true;
    document.getElementById("trainerView").hidden=false;
    document.getElementById("tcontent").hidden=false;
    applyStaffRole(); refreshStaff(); refreshDashboard(); populateLearnerFormations(r.formations||[]); renderCreated("staff"); renderCreated("learner");
    document.querySelectorAll(".sp").forEach(function(p){p.hidden=p.id!=="pD"});
    if(typeof startLive=== "function")startLive();
  }
}
function openAuth(){document.getElementById("authModal").hidden=false;document.getElementById("authEmail").focus()}
document.querySelectorAll(".openLogin,.formationAccess").forEach(function(x){x.onclick=function(){openAuth()}});
document.getElementById("authClose").onclick=function(){document.getElementById("authModal").hidden=true};document.getElementById("menuBtn").onclick=function(){document.getElementById("publicNav").classList.toggle("open")};document.getElementById("currentYear").textContent=new Date().getFullYear();document.getElementById("forgotBtn").onclick=function(){document.getElementById("authError").textContent="Contactez votre administrateur ou votre formateur pour réinitialiser votre mot de passe."};
document.getElementById("authLogin").onclick=async function(){var e=document.getElementById("authError");e.textContent="";var identifier=document.getElementById("authEmail").value.trim();var secret=document.getElementById("authPassword").value;if(!identifier||!secret){e.textContent="Entrez votre identifiant ou adresse e-mail, puis votre mot de passe.";return}try{var r=await API("login",{identifier:identifier,password:secret,remember:document.getElementById("rememberMe").checked});if(!r.ok){e.textContent=r.msg||"Identifiant ou mot de passe incorrect.";return}var session={role:r.role||"none",staff_role:r.role=== "formateur"?"formateur":(r.role=== "admin"?"admin":"none"),name:r.name||null,identifier:r.identifier||null,formation_id:r.formation_id||null,must_change_password:!!r.must_change_password,formations:r.formations||[]};document.getElementById("authModal").hidden=true;routeSession(session)}catch(x){e.textContent="Connexion impossible pour le moment."}};
document.getElementById("authPasswordToggle").onclick=function(){var input=document.getElementById("authPassword"),show=input.type=== "password";input.type=show?"text":"password";this.textContent=show?"Masquer":"Afficher"};
document.getElementById("authPassword").addEventListener("keydown",function(e){if(e.key=== "Enter")document.getElementById("authLogin").click()});
try{if(typeof claude!=="undefined"&&claude.use)claude.use("user").then(u=>{if(u&&u.isOwner())$("#tabTrainer").hidden=false}).catch(()=>{})}catch(e){}
</script>
<script>
(function () {
  var LV = [], LEARNERS = [];
  function say(id, text, ok) { var e = $(id); e.textContent = text; e.style.color = ok ? "#1d7a46" : "#b3261e"; }
  function opt(v, t) { return h("option", { value: v, text: t }); }
  function cell(t) { return h("td", { text: t == null ? "" : String(t) }); }
  function table(head, rows) {
    var tb = h("tbody"); rows.forEach(function (r) { tb.append(r); });
    return h("table", {}, h("thead", {}, h("tr", {}, head.map(function (x) { return h("th", { text: x }); }))), tb);
  }
  function levelName(id) { var l = LV.filter(function (x) { return x.id === id; })[0]; return l ? l.name : id; }
  function learnerName(uid) { var l = LEARNERS.filter(function (x) { return x.learner_uid === uid; })[0]; return l ? l.name : uid; }
  function localInput(iso) { if (!iso) return ""; var d = new Date(iso); if (isNaN(d)) return ""; var p = function (n) { return ("0" + n).slice(-2); }; return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + "T" + p(d.getHours()) + ":" + p(d.getMinutes()); }

  function renderLevels() {
    var rows = LV.map(function (l) {
      var n = Number(l.own_questions) || 0, input = h("input", { type: "number", min: "1", max: "20", value: String(l.attempts_allowed), style: "width:70px" });
      var save = h("button", { type: "button", class: "alt", text: "Enregistrer" });
      save.onclick = async function () {
        var r = await API("test_trainer_config_attempts", { level_id: l.id, attempts_allowed: Number(input.value) });
        say("#tvLevelsMsg", r.ok ? "Tentatives enregistrées pour « " + l.name + " »." : "Enregistrement refusé.", !!r.ok);
      };
      var q = n >= 25 ? n + " questions" : (n > 0 ? n + " questions (insuffisant)" : "ancien découpage (3 à 4 questions)");
      var exam = Number(l.exam_active) ? "activé" : "désactivé";
      var tr = h("tr", {}, cell(l.formation_name), cell(l.name), cell(q), h("td", {}, input, save), cell(l.pass_percent + " %"), cell(exam));
      if (n < 25) tr.style.background = "rgba(230,126,34,.12)";
      return tr;
    });
    var box = $("#tvLevels"); box.textContent = "";
    box.append(table(["Formation", "Niveau", "Questions", "Tentatives autorisées", "Seuil", "Examen"], rows));
  }
  function fillSelects() {
    var ls = $("#tvLearner"), gradeLs = $("#gradeLearner"), lv = $("#tvLevel"), ex = $("#tvExamLevel");
    ls.textContent = ""; gradeLs.textContent = ""; ex.textContent = "";
    LEARNERS.forEach(function (x) { var option=h("option", { value: x.learner_uid, "data-formation": x.formation_id || "", text: x.name + " (" + (x.identifier || "") + ")" }); ls.append(option); gradeLs.append(option.cloneNode(true)); });
    LV.forEach(function (l) { ex.append(opt(l.id, l.formation_name + " — " + l.name)); });
    refreshLevelSelect(); fillExam();
  }
  function refreshLevelSelect() {
    var lv = $("#tvLevel"), sel = $("#tvLearner").selectedOptions[0], f = sel ? sel.getAttribute("data-formation") : "";
    lv.textContent = "";
    LV.filter(function (l) { return !f || l.formation_id === f; }).forEach(function (l) { lv.append(opt(l.id, l.name)); });
  }
  async function loadProjectGradeForm() {
    var uid=$("#gradeLearner").value,box=$("#projectGradeForm");box.textContent="";
    if(!uid){box.append(h("p",{class:"muted",text:"Choisissez un apprenant."}));return}
    var response=await API("project_grades_get",{learner_uid:uid});
    if(!response||response.error){box.append(h("p",{class:"muted",text:"Impossible de charger les notes de projet."}));return}
    var scores=response.scores||{};Object.keys(response.rubric||{}).forEach(function(key){
      var input=h("input",{type:"number",min:"0",max:"20",step:"0.01",value:scores[key]===null?"":String(scores[key]),"data-project-score":key,"aria-label":response.rubric[key]+" sur 20"});
      box.append(h("label",{text:response.rubric[key]+" (/20)"},input));
    });
    if(!Object.keys(response.rubric||{}).length)box.append(h("p",{class:"muted",text:"Cette formation ne possède pas de grille de projet configurée."}));
    $("#projectGradeSave").disabled=!Object.keys(response.rubric||{}).length;
  }
  async function saveProjectGrades(){
    var uid=$("#gradeLearner").value,scores={};document.querySelectorAll("[data-project-score]").forEach(function(input){scores[input.getAttribute("data-project-score")]=input.value===""?null:Number(input.value)});
    if(!uid||!Object.keys(scores).length){say("#projectGradeMsg","Choisissez un apprenant et vérifiez la grille.",false);return}
    var result=await API("project_grades_set",{learner_uid:uid,scores:scores});
    say("#projectGradeMsg",result.ok?"Notes enregistrées. La moyenne a été recalculée.":(result.msg||"Enregistrement refusé."),!!result.ok);
    if(result.ok)await loadGrades();
  }
  function fillExam() {
    var l = LV.filter(function (x) { return x.id === $("#tvExamLevel").value; })[0]; if (!l) return;
    $("#tvExamActive").checked = Number(l.exam_active) === 1;
    $("#tvExamStart").value = localInput(l.starts_at); $("#tvExamEnd").value = localInput(l.closes_at);
    $("#tvExamAttempts").value = l.exam_attempts || 1; $("#tvExamCorr").value = l.correction_mode || "manuel";
  }
  async function act(kind) {
    var uid = $("#tvLearner").value, level = $("#tvLevel").value, reason = $("#tvReason").value.trim();
    if (!uid || !level) { say("#tvMsg", "Choisissez un apprenant et un niveau.", false); return; }
    if (kind === "unlock") {
      if (reason.length < 5) { say("#tvMsg", "Indiquez le motif du déblocage (5 caractères minimum).", false); return; }
      if (!confirm("Débloquer « " + levelName(level) + " » pour " + learnerName(uid) + " sans que le seuil soit atteint ? L’action sera enregistrée dans le journal.")) return;
    }
    var r = await API(kind === "unlock" ? "test_trainer_unlock_level" : "test_trainer_extra_attempt", { learner_uid: uid, level_id: level, reason: reason });
    say("#tvMsg", r.ok ? (kind === "unlock" ? "Niveau débloqué (marqué comme déblocage manuel)." : "Tentative supplémentaire accordée.") : (r.msg || "Action refusée."), !!r.ok);
    if (r.ok) { $("#tvReason").value = ""; loadLog(); }
  }
  async function saveExam(pub) {
    var level = $("#tvExamLevel").value, m = $("#tvExamMsg"); var r;
    if (pub === undefined) {
      var s = $("#tvExamStart").value, e = $("#tvExamEnd").value;
      r = await API("exam_config_set", { level_id: level, active: $("#tvExamActive").checked ? 1 : 0, starts_at: s ? new Date(s).toISOString() : "", closes_at: e ? new Date(e).toISOString() : "", attempts_allowed: Number($("#tvExamAttempts").value) || 1, correction_mode: $("#tvExamCorr").value });
      say("#tvExamMsg", r.ok ? "Examen enregistré." : (r.error === "bad_period" ? "La fermeture doit être après l’ouverture." : "Enregistrement refusé."), !!r.ok);
    } else {
      r = await API("exam_corrections_publish", { level_id: level, published: pub });
      say("#tvExamMsg", r.ok ? (pub ? "Corrections publiées." : "Corrections masquées.") : "Action refusée (l’examen est-il enregistré ?).", !!r.ok);
    }
    if (r.ok) loadTests(true);
  }
  async function loadAttemptResults() {
    var r = await API("test_trainer_results", {}), rows = (r.results || []).slice(0, 100).map(function (x) {
      return h("tr", {}, cell((x.submitted_at || x.started_at || "").replace("T", " ").slice(0, 16)), cell(learnerName(x.learner_uid)), cell(levelName(x.level_id)), cell(x.mode), cell(x.attempt_number), cell(x.status === "submitted" ? x.score + "/" + x.total + " (" + x.percentage + " %)" : "—"), cell(x.status));
    });
    var box = $("#tvResults"); box.textContent = "";
    box.append(rows.length ? table(["Date", "Apprenant", "Niveau", "Mode", "Tentative", "Résultat", "Statut"], rows) : h("p", { class: "muted", text: "Aucun test passé pour le moment." }));
  }
  async function loadGrades() {
    var gradeResponse=await API("test_grades",{}),gradeRows=(gradeResponse.grades||[]).map(function(g){var p=g.pathway||{},e=g.final_exam||{};var examState=e.status==="passed"?"Réussi":e.status==="failed"?"Échoué":e.status==="in_progress"?"En cours":"Non passé";var states=(p.levels||[]).map(function(level,index){return "Étape "+(index+1)+" : "+(level.validated?"validée":level.manual_unlock?"débloquée, non validée":"non validée")}).join(" · ");return h("tr",{},cell(g.learner_name),cell(g.formation_name),cell(p.score+"/10 · "+p.validated_count+"/6"),cell(states||"Aucune étape"),cell(e.score+"/10 · "+examState),cell((g.tests_total===undefined?g.total:g.tests_total)+"/20"),cell(Number(g.project_score||0)+"/20 ("+Number((g.project||{}).graded_count||0)+"/"+Number((g.project||{}).rubric_count||0)+")"),cell(Number(g.presentation_score||0)+"/20"),cell(Number(g.final_average||0)+"/20 · "+(g.mention||"")));});
    var gradeBox=$("#testGradesTable");if(gradeBox){gradeBox.textContent="";gradeBox.append(gradeRows.length?table(["Apprenant","Formation","Étapes","État de chaque étape","Examen final","Total tests","Projet","Présentation","Moyenne finale"],gradeRows):h("p",{class:"muted",text:"Aucune note à afficher."}));}
  }
  async function loadResultsPage(){var l=await API("learner_list",{});LEARNERS=(l.rows||[]).filter(function(x){return Number(x.active)!==0});var a=await API("trainer_levels_list",{});LV=a.levels||[];await loadAttemptResults();}
  async function loadGradesPage(){var l=await API("learner_list",{});LEARNERS=(l.rows||[]).filter(function(x){return Number(x.active)!==0});var sel=$("#gradeLearner"),current=sel.value;sel.textContent="";LEARNERS.forEach(function(x){sel.append(h("option",{value:x.learner_uid,text:x.name+" ("+(x.identifier||"")+")"}))});if(current&&LEARNERS.some(function(x){return x.learner_uid===current}))sel.value=current;await loadGrades();await loadProjectGradeForm();}
  async function loadLog() {
    var r = await API("trainer_actions_list", {}), names = { extra_attempt: "Tentative supplémentaire", manual_unlock: "Déblocage manuel", config_attempts: "Réglage des tentatives", exam_config: "Configuration d’examen" };
    var rows = (r.rows || []).map(function (x) {
      return h("tr", {}, cell((x.created_at || "").replace("T", " ").slice(0, 16)), cell(x.actor), cell(names[x.action] || x.action), cell(x.learner_name || ""), cell(levelName(x.level_id)), cell(x.details || ""));
    });
    var box = $("#tvLog"); box.textContent = "";
    box.append(rows.length ? table(["Date", "Par", "Action", "Apprenant", "Niveau", "Détail / motif"], rows) : h("p", { class: "muted", text: "Aucune action enregistrée." }));
  }
  async function loadTests(keepSelection) {
    var a = await API("trainer_levels_list", {}); LV = a.levels || [];
    var l = await API("learner_list", {}); LEARNERS = (l.rows || []).filter(function (x) { return Number(x.active) !== 0; });
    var keep = $("#tvExamLevel").value;
    renderLevels(); fillSelects(); if (keepSelection && keep) { $("#tvExamLevel").value = keep; fillExam(); }
    await loadAttemptResults(); await loadLog();
  }
  window.loadTests = loadTests;
  window.loadGradesPage = loadGradesPage;
  window.loadResultsPage = loadResultsPage;
  $("#navTests").addEventListener("click", function () { loadTests(false); });
  $("#tvLearner").onchange = refreshLevelSelect; $("#gradeLearner").onchange=loadProjectGradeForm; $("#projectGradeSave").onclick=saveProjectGrades; $("#tvExamLevel").onchange = fillExam;
  $("#tvExtra").onclick = function () { act("extra"); }; $("#tvUnlock").onclick = function () { act("unlock"); };
  $("#tvExamSave").onclick = function () { saveExam(); }; $("#tvExamPub").onclick = function () { saveExam(1); }; $("#tvExamHide").onclick = function () { saveExam(0); };
})();
</script>
</body>
</html>
