async function refreshDashboard(){
  try {
    var r = await API("admin_dashboard", {});
    if (!r || r.error) throw new Error("dashboard_unavailable");
    var box = $("#dashStats");
    if (box) { box.textContent = ""; [["Apprenants actifs", r.learner_count || 0], [STAFF_ROLE==="admin"?"Formations actives":"Formations attribuées", r.formation_count || 0], ["Modules actifs", r.module_count || 0], ["Tests réalisés", r.test_count || 0]].forEach(function (c) { box.append(h("div", { class: "staff-stat" }, h("strong", { text: String(c[1]) }), h("span", { text: c[0] }))); }); }
    var rec = $("#dashRecent");
    if (rec) { rec.textContent = ""; var rows = r.latest || []; if (!rows.length) { rec.append(h("div", { class: "staff-empty", text: "Aucun résultat récent. Les résultats apparaîtront ici après les premières évaluations." })); } else { var bd = h("tbody"); rows.forEach(function (e) { bd.append(h("tr", {}, h("td", { text: e.learner_name || "" }), h("td", { text: e.formation_id || "" }), h("td", { text: (e.score || 0) + "/" + (e.total || 0) + " (" + (e.percentage || 0) + " %)" }), h("td", { text: String(e.created || "").slice(0, 16).replace("T", " ") }))); }); rec.append(h("div", { class: "wrap" }, h("table", {}, h("thead", {}, h("tr", {}, ["Apprenant", "Formation", "Score", "Date"].map(function (t) { return h("th", { text: t }); }))), bd))); } }
    var cbox = $("#dashCredentials");
    if (cbox) { cbox.textContent = ""; var sarr = []; try { sarr = JSON.parse(localStorage.getItem("ndartech_staff_created") || "[]"); } catch (e) { } var larr = []; try { larr = JSON.parse(localStorage.getItem("ndartech_learner_created") || "[]"); } catch (e) { } var all = sarr.concat(larr); if (!all.length) { cbox.append(h("p", { class: "muted", text: "Aucun identifiant créé sur cet appareil." })); } else { all.slice(0, 5).forEach(function (o) { if (!o) return; var identifier = o.username || o.identifier; if (!identifier) return; cbox.append(h("div", { class: "staff-stat" }, h("strong", { text: o.name || identifier }), h("span", { text: (o.role ? o.role + " · " : "") + "Identifiant : " + identifier }))); }); } }
  } catch (e) { console.error("refreshDashboard error:", e); var b = $("#dashStats"); if (b) b.textContent = ""; if (b) b.append(h("div", { class: "staff-empty", role: "alert", text: "Impossible de charger le tableau de bord. Vérifiez la connexion puis réessayez." })); }
}

