function renderCreated(type){var key=type==="staff"?"ndartech_staff_created":"ndartech_learner_created";var sel=type==="staff"?"#staffCreated":"#learnerCreated";var arr=[];try{arr=JSON.parse(localStorage.getItem(key)||"[]")}catch(e){}var box=$(sel);box.textContent="";if(!arr.length){box.append(h("p",{class:"muted",text:"Aucun identifiant créé."}));return}arr.forEach(function(o){var card=h("div",{style:"border:1.5px solid var(--line);border-radius:10px;padding:10px;margin:6px 0;background:var(--card)"});if(type==="staff"){card.append(h("b",{text:o.name+" ("+o.role+")"}),h("div",{text:"Identifiant : "+o.username}),h("div",{class:"muted",text:"Mot de passe temporaire communiqué une seule fois à la création ou à la réinitialisation."}),h("div",{class:"muted",text:"Formations : "+(o.formations||[]).join(", ")}))}else{card.append(h("b",{text:o.name}),h("div",{text:"Identifiant : "+o.identifier}),h("div",{class:"muted",text:"Mot de passe temporaire communiqué une seule fois à la création ou à la réinitialisation."}),h("div",{class:"muted",text:"Formation : "+o.formation}))}box.append(card)});var clr=h("button",{type:"button",class:"alt",text:"Effacer la liste",style:"margin-top:8px"});clr.onclick=function(){localStorage.removeItem(key);renderCreated(type)};box.append(clr)}
async function loadLearners(){
  try{var r=await API("learner_list",{});var rows=r.rows||[];ROSTER=rows.filter(x=>x.active==1).map(x=>x.name);IDS=rows.filter(x=>x.active==1).map(x=>({n:x.name,id:x.learner_id,dbId:x.id}));$("#names").value=ROSTER.join("\n");$("#mkCsv").hidden=!IDS.length;renderRoster();renderLearnersTable()}catch(e){$("#idsMsg").textContent="Liste des apprenants indisponible."}
}
var STAFF_EVALUATIONS=[];
async function refreshDynamicResults(){
  var status=$("#resultsStatus"),box=$("#serverResults"),csv=$("#resultsCsv");
  status.textContent="Chargement des résultats…";box.textContent="";csv.hidden=true;
  try{
    var response=await API("evaluations_list",{});
    if(!response||response.error)throw new Error("evaluations_unavailable");
    STAFF_EVALUATIONS=response.rows||[];
    if(!STAFF_EVALUATIONS.length){box.append(h("p",{class:"staff-empty",text:"Aucune évaluation enregistrée pour le moment."}));status.textContent="Liste actualisée.";return}
    var body=h("tbody");
    STAFF_EVALUATIONS.forEach(function(result){
      var date=String(result.created||"").replace("T"," ").slice(0,16)||"—";
      body.append(h("tr",{},
        h("td",{text:result.learner_name||"—"}),
        h("td",{text:result.formation_name||result.formation_id||"—"}),
        h("td",{text:result.module_name||result.module_id||"Général"}),
        h("td",{text:learnerModeLabel(result.mode)}),
        h("td",{text:Number(result.score||0)+"/"+Number(result.total||0)+" ("+Number(result.percentage||0)+" %)"}),
        h("td",{text:date})
      ));
    });
    box.append(h("table",{},
      h("thead",{},h("tr",{},["Apprenant","Formation","Module","Mode","Score","Date"].map(function(label){return h("th",{text:label})}))),
      body
    ));
    csv.hidden=false;
    status.textContent=STAFF_EVALUATIONS.length+" évaluation(s) affichée(s).";
  }catch(e){
    STAFF_EVALUATIONS=[];
    status.textContent="Impossible de charger les résultats. Vérifiez la connexion puis réessayez.";
    box.append(h("p",{class:"staff-empty",role:"alert",text:status.textContent}));
  }
}
async function startLive(){await Promise.all([refreshDynamicResults(),loadLearners()])}
$("#resultsRefresh").onclick=refreshDynamicResults;
$("#resultsCsv").onclick=function(){
  var rows=[["Apprenant","Formation","Module","Mode","Score","Total","Pourcentage","Durée (s)","Date"].map(qq).join(";")];
  STAFF_EVALUATIONS.forEach(function(result){rows.push([result.learner_name||"",result.formation_name||result.formation_id||"",result.module_name||result.module_id||"",learnerModeLabel(result.mode),result.score,result.total,result.percentage,result.duration_seconds,result.created].map(qq).join(";"))});
  saveCsv(rows,"resultats-apprenants.csv",$("#resultsStatus"));
};
